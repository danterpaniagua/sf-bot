input {
  azure_event_hubs {
    config_mode => "basic"
    event_hub_connections => "REDACTED"
    consumer_group => "logstash"
    storage_connection => "REDACTED"
    storage_container => "logstash-checkpoints"
    threads => 4
    decorate_events => true
  }
}
filter {
  json {
    source => "message"
    skip_on_invalid_json => true
  }
  # Azure Diagnostic Settings batch multiple log records into a single Event
  # Hub message under a top-level "records" field — an ARRAY when the batch
  # has multiple records, but a bare HASH (not array-wrapped) when the batch
  # has exactly one. Normalize to always be an Array before `split` runs,
  # since `split` silently no-ops on a Hash.
  #
  # NOTE ON QUOTING: every `ruby` block below uses SINGLE quotes for the
  # outer Logstash `code => '...'` string, specifically so the Ruby code
  # inside can use double quotes (and #{...} interpolation) with ZERO
  # escaping. Do not introduce a literal single quote anywhere inside these
  # blocks — it would prematurely close the outer string. An earlier version
  # mixed double-quoted Logstash strings with escaped \"...\" for Ruby
  # interpolation and reliably crash-looped Logstash with a JRuby "syntax
  # error, unexpected backslash" — confirmed reproducible even from a clean
  # hand-written file, not a sed/deployment corruption as first suspected.
  ruby {
    code => '
      records = event.get("records")
      event.set("records", [records]) if records.is_a?(Hash)
    '
  }
  if [records] {
    split {
      field => "records"
    }
  }
  # `split` only replaces the array with a single element under the same
  # field name — it does NOT promote that element's own keys (resourceId/
  # category/properties/etc.) to the top level of the event. Without this,
  # GELF flattens the leftover nested `records` hash into `records_*`-
  # prefixed fields, which was found colliding with the top-level
  # `resourceId`/`properties` field mappings in OpenSearch
  # (mapper_parsing_exception at index time).
  ruby {
    code => '
      record = event.get("records")
      if record.is_a?(Hash)
        # decorate_events => true sets event_original to the FULL raw Event Hub
        # message (the whole multi-record batch) on every split-out document —
        # harmless at low volume, but routinely exceeds the OpenSearch/Lucene
        # 32,766-byte max term length once batches get large (observed up to
        # 131KB with Business). Overwrite it with the raw JSON for just this
        # one record instead — still true raw source data, just scoped to a
        # single record rather than the whole batch it arrived in.
        event.set("event_original", record.to_json)
        record.each { |k, v| event.set(k, v) }
        event.remove("records")
      else
        # Guard previously had no else — silently left event_original at its
        # ingestion-time full-batch value whenever records was not a Hash here
        # (json parse failure, split failure, or an unexpected shape). Tag for
        # visibility into how often/why this branch is hit; the actual size
        # protection is unconditional below, right before output, and covers
        # this case regardless of the tag.
        event.tag("event_original_guard_skipped")
      end
    '
  }
  # Split resourceId into subscription/resource_group/type/name/resource_path.
  # Subscription ID matched via regex (any UUID), not hardcoded — this project
  # only touches one subscription today but nothing here should assume that.
  # No match (resourceId missing, or not Azure's standard resource ID shape)
  # silently skips these fields — no errors.
  ruby {
    code => '
      rid = event.get("resourceId")
      if rid.is_a?(String)
        m = rid.match(%r{\A/SUBSCRIPTIONS/([0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})/RESOURCEGROUPS/([^/]+)/PROVIDERS/([^/]+)/([^/]+)/(.+)\z}i)
        if m
          sub, rg, provider, rtype, name = m.captures
          event.set("subscription", sub)
          event.set("resource_group", rg)
          event.set("type", "#{provider}/#{rtype}")
          event.set("name", name)
          event.set("resource_path", "#{rg}/PROVIDERS/#{provider}/#{rtype}/#{name}")
        end
      end
    '
  }
  # Azure's schema varies by log category — AppServiceAppLogs has
  # resultDescription/operationName/level; AppServiceHTTPLogs only has
  # time/resourceId/category/properties (request detail lives in properties).
  # A rigid mutate{replace} referencing a single field left message unresolved
  # (literal "%{resultDescription}") for categories lacking that field. Fall
  # back through what's available, building a real summary for HTTP logs from
  # properties before it gets stringified below.
  ruby {
    code => '
      msg = event.get("resultDescription") || event.get("operationName")
      if msg.nil?
        props = event.get("properties")
        if props.is_a?(Hash) && props["CsMethod"] && props["CsUriStem"]
          msg = "#{props["CsMethod"]} #{props["CsUriStem"]} - #{props["ScStatus"]}"
        end
      end
      msg ||= event.get("category") || "log entry"
      event.set("message", msg.to_s)
    '
  }
  # GITIN-1835: AppLevel — a single, universal severity field for every
  # message in every stream, not just where a source shape happens to make
  # one obvious. Priority order:
  #   1. Top-level "Level" (Sales direct-GELF messages — set by the very
  #      first json filter at the top of this file, before any
  #      records-splitting even runs, straight from Serilogs own CLEF line).
  #   2. The real app severity nested inside "resultDescription", when its a
  #      JSON-encoded string (AppServiceConsoleLogs — Azures own outer
  #      "level" for this category is just a generic stdout-stream
  #      classification, near-always "Informational", not the real one;
  #      confirmed via a real Admin-PRO message).
  #   3. Azures own outer "level" string otherwise (AppServiceAppLogs,
  #      where resultDescription is plain text like "Thread was being
  #      aborted." and the outer level IS the real severity). Still a
  #      string at this point in the filter chain — the gelf output plugin
  #      only coerces "level" to numeric at serialization time, outside
  #      this filter block entirely, so its safe to read here as a string.
  #   4. "Unknown" — final fallback so every message gets a value, even
  #      AppServiceHTTPLogs, which has no severity concept of its own.
  ruby {
    code => '
      app_level = nil
      top_level = event.get("Level")
      if top_level.is_a?(String)
        app_level = top_level
      else
        result_desc = event.get("resultDescription")
        if result_desc.is_a?(String) && result_desc.strip.start_with?("{")
          begin
            parsed = JSON.parse(result_desc)
            app_level = parsed["Level"] if parsed.is_a?(Hash) && parsed["Level"].is_a?(String)
          rescue JSON::ParserError
          end
        end
        if app_level.nil?
          raw_level = event.get("level")
          app_level = raw_level if raw_level.is_a?(String)
        end
      end
      app_level ||= "Unknown"
      event.set("AppLevel", app_level)
    '
  }
  # GITIN-1883: TraceKey / TenantId — promote from Properties.TraceKey and
  # Properties.TenantId, the same Serilog CLEF payload nested inside
  # resultDescription that the AppLevel block above already parses (one
  # JSON-string layer deeper than Sales direct-GELF messages, whose top-level
  # Properties GELF already auto-flattens on its own — see GITIN-1835).
  # Confirmed present in 6/6 sampled AppServiceConsoleLogs messages (Business/
  # Admin/Platform/Person/Catalog/Orders); Sales/Pos emit 0 messages in this
  # category at all (GITIN-1811, unsupported on Windows/.NET), out of scope.
  # TenantId is legitimately empty on system/background messages with no
  # active tenant context (confirmed on 3 of 6 sampled apps) — leave the field
  # unset rather than promote an empty string.
  ruby {
    code => '
      result_desc = event.get("resultDescription")
      if result_desc.is_a?(String) && result_desc.strip.start_with?("{")
        begin
          parsed = JSON.parse(result_desc)
          if parsed.is_a?(Hash) && parsed["Properties"].is_a?(Hash)
            props = parsed["Properties"]
            event.set("TraceKey", props["TraceKey"]) if props["TraceKey"].is_a?(String) && !props["TraceKey"].empty?
            event.set("TenantId", props["TenantId"]) if props["TenantId"].is_a?(String) && !props["TenantId"].empty?
            event.set("Service", props["Service"]) if props["Service"].is_a?(String) && !props["Service"].empty?
            event.set("Environment", props["Environment"]) if props["Environment"].is_a?(String) && !props["Environment"].empty?
          end
        rescue JSON::ParserError
        end
      end

      # --- Sales direct-GELF: Properties is a top-level Hash on the event ---
      top_props = event.get("Properties")
      if top_props.is_a?(Hash)
        event.set("TraceKey", top_props["TraceKey"]) if top_props["TraceKey"].is_a?(String) && !top_props["TraceKey"].empty?
        event.set("TenantId", top_props["TenantId"]) if top_props["TenantId"].is_a?(String) && !top_props["TenantId"].empty?
        event.set("Service", top_props["Service"]) if top_props["Service"].is_a?(String) && !top_props["Service"].empty?
        event.set("Environment", top_props["Environment"]) if top_props["Environment"].is_a?(String) && !top_props["Environment"].empty?
        # Stringify so GELF/Graylog does not auto-flatten this into
        # Properties_* duplicates on the way out — see comment block above.
        event.set("Properties", top_props.to_json)
      end
    '
  }
  # GITIN-2098: TraceId / SpanId / ParentId - promote the W3C distributed-
  # tracing triple from Properties.TraceId/.SpanId/.ParentId, the same
  # Serilog CLEF payload GITIN-1883/1892 already read. Confirmed in
  # application source (Provider.Logger.Core/W3CAndAmbientTraceEnricher.cs,
  # registered in SerilogBootstrap.cs alongside Service/Environment/Version)
  # that these are stamped from Activity.Current onto every log line, for
  # every service built on the shared SerilogBootstrap - same universal
  # reach as TraceKey, not confined to one specific log line (unlike the
  # Request-finished line GITIN-1940 promotes StatusCode/Path/Method/
  # ElapsedMilliseconds from). Distinct from the business TraceKey the app
  # sets (GITIN-1883): this is the W3C/OpenTelemetry trace triple, lowercase-
  # hex form. Same two-branch split as GITIN-1883/1892 blocks above.
  ruby {
    code => '
      # --- Event Hub apps: Properties nested inside resultDescription ---
      result_desc = event.get("resultDescription")
      if result_desc.is_a?(String) && result_desc.strip.start_with?("{")
        begin
          parsed = JSON.parse(result_desc)
          if parsed.is_a?(Hash) && parsed["Properties"].is_a?(Hash)
            props = parsed["Properties"]
            event.set("TraceId", props["TraceId"]) if props["TraceId"].is_a?(String) && !props["TraceId"].empty?
            event.set("SpanId", props["SpanId"]) if props["SpanId"].is_a?(String) && !props["SpanId"].empty?
            event.set("ParentId", props["ParentId"]) if props["ParentId"].is_a?(String) && !props["ParentId"].empty?
          end
        rescue JSON::ParserError
        end
      end

      # --- Sales / SFC-PosWasmRelay direct-GELF: Properties already stringified by the GITIN-1883 block above ---
      props_str = event.get("Properties")
      if props_str.is_a?(String) && props_str.strip.start_with?("{")
        begin
          top_props = JSON.parse(props_str)
          if top_props.is_a?(Hash)
            event.set("TraceId", top_props["TraceId"]) if top_props["TraceId"].is_a?(String) && !top_props["TraceId"].empty?
            event.set("SpanId", top_props["SpanId"]) if top_props["SpanId"].is_a?(String) && !top_props["SpanId"].empty?
            event.set("ParentId", top_props["ParentId"]) if top_props["ParentId"].is_a?(String) && !top_props["ParentId"].empty?
          end
        rescue JSON::ParserError
        end
      end
    '
  }
  # GITIN-1892: Version / UserId / ProcessType / Component / RequestId / Category /
  # SourceContext / ErrorCode / Operation / Recovered / Handled / AuditAction
  # / AuditOutcome — promote to bare top-level fields for ALL services with
  # this data available: the 6 Event Hub apps from GITIN-1883
  # (Business/Admin/Platform/Person/Catalog/Orders) AND Sales (direct-GELF).
  # Pos stays out of scope — emits 0 AppServiceConsoleLogs messages at all
  # (GITIN-1811, unsupported on Windows/.NET), same as GITIN-1883.
  #
  # Two source branches, same split as GITIN-1883's block above:
  #   1. Event Hub apps: Properties nested inside resultDescription (same
  #      parse as GITIN-1883).
  #   2. Sales: by the time this block runs, GITIN-1883's block above has
  #      ALREADY stringified the event's top-level "Properties" field (to
  #      stop GELF auto-flatten) — it is a JSON string here, not a live Hash
  #      like it still is inside GITIN-1883's own block. Re-parse it rather
  #      than reading a Hash directly. First draft of this ticket omitted
  #      Sales entirely; caught before deploy.
  #
  # `props["X"].is_a?(String)` is already nil-safe (a missing key returns
  # nil, and nil.is_a?(String) is false), so it naturally skips fields that
  # are absent entirely, not just empty, with no extra key-presence check
  # needed. Recovered/Handled are booleans in the CLEF payload (see
  # cloud/docs/devs-log-structure.md §6.4/§6.6), not strings — guarded
  # against a boolean-or-nil check instead.
  #
  # UserId/ProcessType/Component/RequestId confirmed present on every sampled
  # message regardless of which helper emitted it (2026-08-19, 8 real
  # AppServiceConsoleLogs samples across Business/Admin/Platform/Person/
  # Catalog/Orders — Sales not independently sampled for this ticket, relies
  # on the same canonical field set documented in devs-log-structure.md
  # §3.2, already exercised live by GITIN-1883 for TraceKey/TenantId/Service/
  # Environment on Sales). Category/SourceContext/ErrorCode/Operation/
  # Recovered/Handled/AuditAction/AuditOutcome only appear when the log was
  # raised through one of the 6 canonical SmartFranLogExtensions helpers (see
  # devs-log-structure.md §3.3) — confirmed absent on all sampled plain
  # framework/middleware messages, and not independently confirmed present
  # anywhere in this cluster's 7-day window (resultDescription turned out to
  # be keyword-mapped, not tokenized — pre-deploy substring search needed a
  # regex query form only worked out after several rounds of debugging).
  # Shapes for these 8 are sourced directly from devs-log-structure.md's
  # worked examples (§6.3 LogDomainError, §6.4 LogTransientFailure, §6.6
  # LogUnrecoverableFailure, §6.7 LogSecurityAudit) rather than a live
  # sample. No risk either way: the guard means a field that never actually
  # fires simply never promotes. Live confirmation via the same
  # resultDescription:/.*X.*/ regex query (Event Hub apps) or a plain
  # _exists_:<field> check (Sales, once flat) is a post-deploy verification
  # step, not a pre-deploy blocker — same as GITIN-1883's _exists_:<field>.
  ruby {
    code => '
      # --- Event Hub apps: Properties nested inside resultDescription ---
      result_desc = event.get("resultDescription")
      if result_desc.is_a?(String) && result_desc.strip.start_with?("{")
        begin
          parsed = JSON.parse(result_desc)
          if parsed.is_a?(Hash) && parsed["Properties"].is_a?(Hash)
            props = parsed["Properties"]
            event.set("Version", props["Version"]) if props["Version"].is_a?(String) && !props["Version"].empty?
            event.set("UserId", props["UserId"]) if props["UserId"].is_a?(String) && !props["UserId"].empty?
            event.set("ProcessType", props["ProcessType"]) if props["ProcessType"].is_a?(String) && !props["ProcessType"].empty?
            event.set("Component", props["Component"]) if props["Component"].is_a?(String) && !props["Component"].empty?
            event.set("RequestId", props["RequestId"]) if props["RequestId"].is_a?(String) && !props["RequestId"].empty?
            event.set("Category", props["Category"]) if props["Category"].is_a?(String) && !props["Category"].empty?
            event.set("SourceContext", props["SourceContext"]) if props["SourceContext"].is_a?(String) && !props["SourceContext"].empty?
            event.set("ErrorCode", props["_error_code"]) if props["_error_code"].is_a?(String) && !props["_error_code"].empty?
            event.set("Operation", props["Operation"]) if props["Operation"].is_a?(String) && !props["Operation"].empty?
            event.set("Recovered", props["_recovered"]) if [true, false].include?(props["_recovered"])
            event.set("Handled", props["_handled"]) if [true, false].include?(props["_handled"])
            event.set("AuditAction", props["_audit_action"]) if props["_audit_action"].is_a?(String) && !props["_audit_action"].empty?
            event.set("AuditOutcome", props["_audit_outcome"]) if props["_audit_outcome"].is_a?(String) && !props["_audit_outcome"].empty?
          end
        rescue JSON::ParserError
        end
      end

      # --- Sales direct-GELF: Properties already stringified by the GITIN-1883 block above ---
      props_str = event.get("Properties")
      if props_str.is_a?(String) && props_str.strip.start_with?("{")
        begin
          top_props = JSON.parse(props_str)
          if top_props.is_a?(Hash)
            event.set("Version", top_props["Version"]) if top_props["Version"].is_a?(String) && !top_props["Version"].empty?
            event.set("UserId", top_props["UserId"]) if top_props["UserId"].is_a?(String) && !top_props["UserId"].empty?
            event.set("ProcessType", top_props["ProcessType"]) if top_props["ProcessType"].is_a?(String) && !top_props["ProcessType"].empty?
            event.set("Component", top_props["Component"]) if top_props["Component"].is_a?(String) && !top_props["Component"].empty?
            event.set("RequestId", top_props["RequestId"]) if top_props["RequestId"].is_a?(String) && !top_props["RequestId"].empty?
            event.set("Category", top_props["Category"]) if top_props["Category"].is_a?(String) && !top_props["Category"].empty?
            event.set("SourceContext", top_props["SourceContext"]) if top_props["SourceContext"].is_a?(String) && !top_props["SourceContext"].empty?
            event.set("ErrorCode", top_props["_error_code"]) if top_props["_error_code"].is_a?(String) && !top_props["_error_code"].empty?
            event.set("Operation", top_props["Operation"]) if top_props["Operation"].is_a?(String) && !top_props["Operation"].empty?
            event.set("Recovered", top_props["_recovered"]) if [true, false].include?(top_props["_recovered"])
            event.set("Handled", top_props["_handled"]) if [true, false].include?(top_props["_handled"])
            event.set("AuditAction", top_props["_audit_action"]) if top_props["_audit_action"].is_a?(String) && !top_props["_audit_action"].empty?
            event.set("AuditOutcome", top_props["_audit_outcome"]) if top_props["_audit_outcome"].is_a?(String) && !top_props["_audit_outcome"].empty?
          end
        rescue JSON::ParserError
        end
      end
    '
  }
  # GITIN-1940: StatusCode / Path / Method / ElapsedMilliseconds — promote
  # from the built-in ASP.NET Core "Request finished" hosting-diagnostics log
  # line (SourceContext: Microsoft.AspNetCore.Hosting.Diagnostics). This is
  # framework request logging, not a SmartFranLogExtensions helper — present
  # on every HTTP request regardless of app-level enrichment. Motivated by
  # Sales WsFeAr/CaeRequest 408s: without these fields, "endpoint X returned
  # status Y" can only be found via full-text search over `message`, since
  # neither field was previously promoted for any service.
  # Same two-branch split as GITIN-1883/1892's blocks above. RequestPath
  # duplicates Path in every sample seen so far — only Path is promoted, to
  # avoid a redundant field. StatusCode/ElapsedMilliseconds are numeric in
  # the CLEF payload (Integer / Float respectively), not strings — guarded
  # accordingly, same reasoning as Recovered/Handled above.
  ruby {
    code => '
      # --- Event Hub apps: Properties nested inside resultDescription ---
      result_desc = event.get("resultDescription")
      if result_desc.is_a?(String) && result_desc.strip.start_with?("{")
        begin
          parsed = JSON.parse(result_desc)
          if parsed.is_a?(Hash) && parsed["Properties"].is_a?(Hash)
            props = parsed["Properties"]
            event.set("StatusCode", props["StatusCode"]) if props["StatusCode"].is_a?(Integer)
            event.set("Path", props["Path"]) if props["Path"].is_a?(String) && !props["Path"].empty?
            event.set("Method", props["Method"]) if props["Method"].is_a?(String) && !props["Method"].empty?
            event.set("ElapsedMilliseconds", props["ElapsedMilliseconds"]) if props["ElapsedMilliseconds"].is_a?(Numeric)
          end
        rescue JSON::ParserError
        end
      end

      # --- Sales direct-GELF: Properties already stringified by the GITIN-1883 block above ---
      props_str = event.get("Properties")
      if props_str.is_a?(String) && props_str.strip.start_with?("{")
        begin
          top_props = JSON.parse(props_str)
          if top_props.is_a?(Hash)
            event.set("StatusCode", top_props["StatusCode"]) if top_props["StatusCode"].is_a?(Integer)
            event.set("Path", top_props["Path"]) if top_props["Path"].is_a?(String) && !top_props["Path"].empty?
            event.set("Method", top_props["Method"]) if top_props["Method"].is_a?(String) && !top_props["Method"].empty?
            event.set("ElapsedMilliseconds", top_props["ElapsedMilliseconds"]) if top_props["ElapsedMilliseconds"].is_a?(Numeric)
          end
        rescue JSON::ParserError
        end
      end

      # --- AppServiceHTTPLogs: Azures own infra-level HTTP access log
      # (Windows Event Hub apps only) — CsMethod/CsUriStem/ScStatus/TimeTaken
      # instead of the app-level ASP.NET Core Request-finished names, but same
      # underlying HTTP request/response metadata. lowercase "properties"
      # arrives as a JSON-encoded STRING directly from Azure for this
      # category (not a nested Hash like AppServiceAppLogs/
      # AppServiceConsoleLogs resultDescription) — confirmed via a real
      # SMARTFRAN-CLOUD-PERSON-PRO sample, 2026-08-26. Distinct field name
      # ("properties", lowercase) from the two branches above ("Properties"/
      # "resultDescription"), so no collision risk. ScStatus is a numeric
      # STRING ("200"), cast to Integer to match StatusCode type from the
      # other two branches; TimeTaken is already an Integer (milliseconds),
      # cast to Float to match ElapsedMilliseconds type and avoid a mixed
      # int/float field. ClientIP (from CIp) has no equivalent in the other
      # two branches — the ASP.NET Core Request-finished line does not carry
      # a client IP property at all — so this field only ever populates from
      # this one source shape.
      # GITIN-2034: properties (lowercase) arrives in TWO different shapes
      # depending on how the raw Event Hub message was batched by Azure —
      # wrapped in a "records" array (pre-stringified by Azure inside that
      # shape) vs. flat/unwrapped (parsed directly into a live Hash by the
      # initial json filter at the top of this file).
      # Confirmed via a real Sales-PRO /api/v1/Status/Health sample
      # (_id: b4966b92-b038-11f1-be92-7c1e52beabec, index http_sales__9,
      # flat/unwrapped shape) where the original String-only guard silently
      # skipped all 5 fields below. Accept both shapes instead of assuming
      # String. ScStatus also varies the same way (numeric String in the
      # wrapped shape, bare Integer in the flat shape) — guarded for both.
      props_json = event.get("properties")
      http_props = nil
      if props_json.is_a?(String) && props_json.strip.start_with?("{")
        begin
          http_props = JSON.parse(props_json)
        rescue JSON::ParserError
        end
      elsif props_json.is_a?(Hash)
        http_props = props_json
      end
      if http_props.is_a?(Hash)
        event.set("Method", http_props["CsMethod"]) if http_props["CsMethod"].is_a?(String) && !http_props["CsMethod"].empty?
        event.set("Path", http_props["CsUriStem"]) if http_props["CsUriStem"].is_a?(String) && !http_props["CsUriStem"].empty?
        if http_props["ScStatus"].is_a?(String) && http_props["ScStatus"].match?(/\A\d+\z/)
          event.set("StatusCode", http_props["ScStatus"].to_i)
        elsif http_props["ScStatus"].is_a?(Integer)
          event.set("StatusCode", http_props["ScStatus"])
        end
        event.set("ElapsedMilliseconds", http_props["TimeTaken"].to_f) if http_props["TimeTaken"].is_a?(Numeric)
        event.set("ClientIP", http_props["CIp"]) if http_props["CIp"].is_a?(String) && !http_props["CIp"].empty?
      end
    '
  }
  # GITIN-1924: SFC-PosWasmRelay-PRO/-DEV — TraceKey/SourceContext fallback
  # from Properties.EntryProperties. The relay (IngestLogs.cs) nests the WASM
  # client's own per-entry Serilog properties one level deeper than its own
  # canonical fields (Service/Environment/TenantId/etc, set via LogContext at
  # the relay process/request level) — under a Hash key "EntryProperties",
  # specifically to avoid colliding with the relay's own promoted fields.
  # GITIN-1883/1892's guards above only ever look at Properties directly, so
  # TraceKey/SourceContext never promote for this source without this
  # fallback. Pure fallback, never an override — only fires when the field
  # is still unset after the blocks above ran — and a no-op for every other
  # service (none of them have an EntryProperties key in Properties).
  #
  # By this point in the filter chain, Properties has already been
  # stringified by GITIN-1883's block above (Sales/relay branch) — re-parse
  # it the same way GITIN-1892's Sales branch does, rather than assuming a
  # live Hash.
  #
  # Values inside EntryProperties carry a literal wrapping `"` character —
  # the WASM client appears to JSON-serialize each entry's value
  # individually before adding it to the dict (confirmed via a real
  # SFC-PosWasmRelay-PRO sample, GITIN-1924: EntryProperties.TraceKey ==
  # "\"SFCPOS.POS:29...\"", not a bare string) — stripped here so the
  # promoted field matches every other service's plain-string format.
  ruby {
    code => '
      trace_key_missing = !(event.get("TraceKey").is_a?(String) && !event.get("TraceKey").empty?)
      source_context_missing = !(event.get("SourceContext").is_a?(String) && !event.get("SourceContext").empty?)
      if trace_key_missing || source_context_missing
        props_str = event.get("Properties")
        if props_str.is_a?(String) && props_str.strip.start_with?("{")
          begin
            top_props = JSON.parse(props_str)
            entry_props = top_props["EntryProperties"] if top_props.is_a?(Hash)
            if entry_props.is_a?(Hash)
              if trace_key_missing
                v = entry_props["TraceKey"]
                event.set("TraceKey", v.sub(/\A"/, "").sub(/"\z/, "")) if v.is_a?(String) && !v.empty?
              end
              if source_context_missing
                v = entry_props["SourceContext"]
                event.set("SourceContext", v.sub(/\A"/, "").sub(/"\z/, "")) if v.is_a?(String) && !v.empty?
              end
            end
          rescue JSON::ParserError
          end
        end
      end
    '
  }
  # 2026-09-15: FunctionAppLogs field promotion. This category has a
  # completely different properties shape than every AppService category
  # above: properties arrives as a Python dict-repr STRING (single-quoted
  # keys/values) rather than JSON, so none of the JSON.parse guards above
  # ever match it (they silently rescue and skip) -- which is why
  # FunctionAppLogs previously got zero field promotion and a generic
  # message of just "Microsoft.Web/sites/functions/log", the operationName
  # fallback set by the block above this one.
  #
  # Two distinct properties.category shapes were found (2026-09-15, 4 real
  # apps -- CodeGenerator, ScheduledJobs, PosWasmRelay, TicketProcess):
  #   "Host.Function.Console" -- properties.message is itself a nested
  #     Python dict-repr string, containing Timestamp/Level/
  #     MessageTemplate/Properties, the latter holding SourceContext/
  #     Service/Environment/Version/TraceId/SpanId/ParentId and
  #     (PosWasmRelay only) a further-nested EntryProperties hash with the
  #     original POS client request Method/Path/StatusCode/ElapsedMs/
  #     TraceKey/etc.
  #   "Function.<name>" or "Function.<name>.User" -- properties.message is
  #     a plain string (for example "Executed Functions.X (Succeeded,
  #     Id=.., Duration=3ms)"), with functionInvocationId/functionName/
  #     eventId/eventName as flat sibling keys of properties itself.
  #
  # Parser logic verified via a standalone Ruby test script against real
  # captured messages across all 4 apps before this went anywhere near the
  # live pipeline (/tmp/cloud-graylog/test_parser.rb, GITIN pending -- ask
  # for a ticket number before merging) -- not guessed from the shape
  # alone.
  #
  # EntryProperties quirk (verified, not assumed): every string value
  # inside EntryProperties (Method, Path, TraceKey, SourceContext,
  # Service, Environment, Version, PosCode, ShiftCode -- but NOT
  # StatusCode/ElapsedMs) carries a literal wrapping quote character as
  # part of the value itself -- for example Path comes back wrapped in
  # quote characters rather than the clean path alone. Same class of quirk
  # already documented above for TraceKey/SourceContext (GITIN-1924) but
  # confirmed here to hit every other EntryProperties string field too --
  # stripped uniformly below.
  #
  # Service collision: properties.message.Properties.Service (the relay
  # Function App own identity) and properties.message.Properties.
  # EntryProperties.Service (the original POS client declared identity)
  # are two different values at two nesting depths. The outer one is
  # promoted to Service (consistent with every other category in this
  # pipeline, where Service means the thing doing the logging); the inner
  # one is promoted to a distinct ClientService field rather than silently
  # overwriting Service.
  #
  # SourceContext also technically appears at both depths for the relay --
  # only the EntryProperties one is promoted here, since the outer one for
  # Host.Function.Console lines is a fixed generic handler class name
  # across almost every message and carries little search value on its
  # own.
  #
  # ParentId is not always present alongside TraceId/SpanId (confirmed
  # absent on PosWasmRelay samples, present on CodeGenerator/
  # ScheduledJobs) -- guarded independently below, not assumed to travel
  # with the other two.
  #
  # Scope and HttpMethod kept out of promotion (redundant with Method plus
  # Path/Uri) -- same dedup reasoning already used above for Path vs
  # RequestPath.
  #
  # Duration/Succeeded extraction from the Function.<name> completion
  # message text was scoped out of this pass -- real but moderate-effort
  # follow-up, not done here.
  if [category] == "FunctionAppLogs" {
    ruby {
      code => '
        q = 39.chr

        strip_wrap = lambda { |v|
          if v.is_a?(String) && v.length >= 2 && v[0] == q && v[-1] == q
            v[1..-2]
          else
            v
          end
        }

        skip_ws = nil
        parse_value = nil
        parse_dict = nil
        parse_list = nil
        parse_string = nil
        parse_literal = nil

        parse_py_literal = lambda { |str|
          next nil unless str.is_a?(String)
          pos = 0
          len = str.length

          skip_ws = lambda {
            pos += 1 while pos < len && str[pos] =~ /\s/
          }

          parse_string = lambda {
            pos += 1
            buf = String.new
            while pos < len
              c = str[pos]
              if c == "\\" && pos + 1 < len
                nc = str[pos + 1]
                if nc == q
                  buf << q
                elsif nc == "\\"
                  buf << "\\"
                elsif nc == "n"
                  buf << "\n"
                elsif nc == "r"
                  buf << "\r"
                elsif nc == "t"
                  buf << "\t"
                else
                  buf << nc
                end
                pos += 2
              elsif c == q
                pos += 1
                break
              else
                buf << c
                pos += 1
              end
            end
            buf
          }

          parse_literal = lambda {
            start = pos
            pos += 1 while pos < len && str[pos] !~ /[,}\]]/
            token = str[start...pos].strip
            if token == "True"
              true
            elsif token == "False"
              false
            elsif token == "None"
              nil
            elsif token =~ /\A-?\d+\z/
              token.to_i
            elsif token =~ /\A-?\d+\.\d+\z/
              token.to_f
            else
              token
            end
          }

          parse_dict = lambda {
            pos += 1
            h = {}
            skip_ws.call
            if pos < len && str[pos] == "}"
              pos += 1
              next h
            end
            loop do
              skip_ws.call
              key = parse_value.call
              skip_ws.call
              pos += 1 if pos < len && str[pos] == ":"
              val = parse_value.call
              h[key] = val
              skip_ws.call
              if pos < len && str[pos] == ","
                pos += 1
                next
              else
                break
              end
            end
            skip_ws.call
            pos += 1 if pos < len && str[pos] == "}"
            h
          }

          parse_list = lambda {
            pos += 1
            arr = []
            skip_ws.call
            if pos < len && str[pos] == "]"
              pos += 1
              next arr
            end
            loop do
              arr << parse_value.call
              skip_ws.call
              if pos < len && str[pos] == ","
                pos += 1
                next
              else
                break
              end
            end
            skip_ws.call
            pos += 1 if pos < len && str[pos] == "]"
            arr
          }

          parse_value = lambda {
            skip_ws.call
            next nil if pos >= len
            if str[pos] == "{"
              parse_dict.call
            elsif str[pos] == "["
              parse_list.call
            elsif str[pos] == q
              parse_string.call
            else
              parse_literal.call
            end
          }

          parse_value.call
        }

        props_str = event.get("properties")
        props = parse_py_literal.call(props_str)

        if props.is_a?(Hash)
          fn_name = props["functionName"]
          fn_inv = props["functionInvocationId"]
          event_name = props["eventName"]

          msg_val = props["message"]
          if msg_val.is_a?(String) && msg_val.strip.start_with?("{")
            nested = parse_py_literal.call(msg_val)
            if nested.is_a?(Hash)
              event.set("message", nested["MessageTemplate"]) if nested["MessageTemplate"].is_a?(String) && !nested["MessageTemplate"].empty?
              event.set("AppLevel", nested["Level"]) if nested["Level"].is_a?(String) && !nested["Level"].empty?

              inner_props = nested["Properties"]
              if inner_props.is_a?(Hash)
                event.set("SourceContext", inner_props["SourceContext"]) if inner_props["SourceContext"].is_a?(String) && !inner_props["SourceContext"].empty?
                event.set("Service", inner_props["Service"]) if inner_props["Service"].is_a?(String) && !inner_props["Service"].empty?
                event.set("Environment", inner_props["Environment"]) if inner_props["Environment"].is_a?(String) && !inner_props["Environment"].empty?
                event.set("Version", inner_props["Version"]) if inner_props["Version"].is_a?(String) && !inner_props["Version"].empty?
                event.set("TraceId", inner_props["TraceId"]) if inner_props["TraceId"].is_a?(String) && !inner_props["TraceId"].empty?
                event.set("SpanId", inner_props["SpanId"]) if inner_props["SpanId"].is_a?(String) && !inner_props["SpanId"].empty?
                event.set("ParentId", inner_props["ParentId"]) if inner_props["ParentId"].is_a?(String) && !inner_props["ParentId"].empty?
                fn_inv ||= inner_props["AzureFunctions_InvocationId"]
                fn_name ||= inner_props["AzureFunctions_FunctionName"]

                ["PosCode", "ShiftCode"].each do |k|
                  v = strip_wrap.call(inner_props[k])
                  event.set(k, v) if v.is_a?(String) && !v.empty?
                end

                ep = inner_props["EntryProperties"]
                if ep.is_a?(Hash)
                  event.set("Method", strip_wrap.call(ep["Method"])) if ep["Method"].is_a?(String) && !ep["Method"].empty?
                  event.set("Path", strip_wrap.call(ep["Path"])) if ep["Path"].is_a?(String) && !ep["Path"].empty?
                  event.set("StatusCode", ep["StatusCode"].to_i) if ep["StatusCode"].is_a?(String) && ep["StatusCode"] =~ /\A\d+\z/
                  event.set("ElapsedMilliseconds", ep["ElapsedMs"].to_f) if ep["ElapsedMs"].is_a?(String) && ep["ElapsedMs"] =~ /\A-?\d+(\.\d+)?\z/
                  event.set("TraceKey", strip_wrap.call(ep["TraceKey"])) if ep["TraceKey"].is_a?(String) && !ep["TraceKey"].empty?
                  event.set("SourceContext", strip_wrap.call(ep["SourceContext"])) if ep["SourceContext"].is_a?(String) && !ep["SourceContext"].empty?
                  event.set("ClientService", strip_wrap.call(ep["Service"])) if ep["Service"].is_a?(String) && !ep["Service"].empty?
                  ["PosCode", "ShiftCode"].each do |k|
                    v = strip_wrap.call(ep[k])
                    event.set(k, v) if v.is_a?(String) && !v.empty?
                  end
                end
              end
            end
          elsif msg_val.is_a?(String) && !msg_val.empty?
            event.set("message", msg_val)
            event.set("AppLevel", props["level"]) if props["level"].is_a?(String) && !props["level"].empty?
          end

          event.set("FunctionName", fn_name) if fn_name.is_a?(String) && !fn_name.empty?
          event.set("FunctionInvocationId", fn_inv) if fn_inv.is_a?(String) && !fn_inv.empty?
          # eventName is literally the string "0" on Function.<name>.User
          # lines (the actual application log statements, not a lifecycle
          # marker) -- a meaningless placeholder, confirmed via testing
          # against real ScheduledJobs samples, not promoted.
          event.set("FunctionEventName", event_name) if event_name.is_a?(String) && !event_name.empty? && event_name != "0"
        end
      '
    }
  }
  # GITIN-2221: NormalizedPath — the HTTP Path with the route parameters removed, so
  # /api/v1/WalletCredentials/2024771231 and /api/v1/WalletCredentials/1357013702
  # both become api_v1_WalletCredentials (route literals joined with "_"). Built from
  # the route templates of the SmartFran.Cloud controllers, loaded from
  # /etc/logstash/normalized-paths.json (generated, see the GITIN-2221 event folder;
  # regenerate it when the controllers' routes change). Path that matches no template
  # gets "unmatched" (keeps the field cardinality bounded). Must stay AFTER every
  # block that sets Path (Event Hub apps, Sales, AppServiceHTTPLogs, PosWasmRelay).
  ruby {
    init => '
      require "json"
      tbl = JSON.parse(File.read("/etc/logstash/normalized-paths.json"))
      @routes = tbl["routes"].map do |r|
        segs = r["t"].split("/").reject { |s| s.empty? }.map do |s|
          if s.start_with?("{*")
            [:rest, nil]
          elsif s.start_with?("{") && s.end_with?("?}")
            [:opt, nil]
          elsif s.start_with?("{")
            [:one, nil]
          else
            [:lit, s.downcase]
          end
        end
        [segs, r["n"], segs.count { |k, _| k == :lit }, segs.count { |k, _| k != :lit }]
      end
      @routes.sort_by! { |_, _, lit, par| [-lit, par] }
      @cache = {}
    '
    code => '
      path = event.get("Path")
      if path.is_a?(String) && !path.empty?
        norm = @cache[path]
        if norm.nil?
          low = path.split("?", 2)[0].split("/").reject { |s| s.empty? }.map { |s| s.downcase }
          norm = "unmatched"
          @routes.each do |segs, n, _, _|
            i = 0
            ok = true
            segs.each do |k, v|
              if k == :lit
                if i < low.length && low[i] == v
                  i += 1
                else
                  ok = false
                  break
                end
              elsif k == :one
                if i < low.length
                  i += 1
                else
                  ok = false
                  break
                end
              elsif k == :opt
                i += 1 if i < low.length
              else
                i = low.length
              end
            end
            if ok && i == low.length
              norm = n
              break
            end
          end
          @cache.clear if @cache.length >= 20000
          @cache[path] = norm
        end
        event.set("NormalizedPath", norm)
      end
    '
  }
  # properties varies in shape across log categories (string vs nested object)
  # — force to a consistent JSON string to avoid OpenSearch mapping conflicts.
  # Runs last: message-building above needs properties as a live Hash.
  if [properties] {
    ruby {
      code => '
        p = event.get("properties")
        event.set("properties", p.to_json) if p.is_a?(Hash)
      '
    }
  }
  # Unconditional safety net, applied to BOTH the flat event_original field this
  # pipeline manipulates AND the ECS-namespaced [event][original] field that
  # pipeline.ecs_compatibility: v8 may populate independently via decorate_events.
  # We haven't conclusively confirmed which one the gelf output actually
  # serializes (2026-07-31 patch attempt truncating only the flat field had zero
  # effect on live failures — see operations/events/20260730_graylog_indexing_failure)
  # so truncate both rather than depend on getting that right. Must never let
  # either exceed OpenSearch/Lucene's 32,766-byte max term length.
  ruby {
    code => '
      max = 30000
      ["event_original", "[event][original]"].each do |field|
        val = event.get(field)
        if val.is_a?(String) && val.bytesize > max
          event.tag("event_original_truncated")
          event.set(field, val.byteslice(0, max) + "...[truncated by Logstash, original was #{val.bytesize} bytes]")
        end
      end
    '
  }
}

output {
  gelf {
    host => "127.0.0.1"
    port => 12201
    protocol => "UDP"
    sender => "%{resource_path}"
  }
  # Uncomment temporarily to inspect raw parsed events while validating the pipeline:
  # stdout { codec => rubydebug }
}
