+  # hex form. Same two-branch split as GITIN-1883/1892 blocks above.
+  ruby {
+    code => '
+      # --- Event Hub apps: Properties nested inside resultDescription ---
+      result_desc = event.get("resultDescription")
+      if result_desc.is_a?(String) && result_desc.strip.start_with?("{")
+        begin
+          parsed = JSON.parse(result_desc)
+          if parsed.is_a?(Hash) && parsed["Properties"].is_a?(Hash)
+            props = parsed["Properties"]
+            event.set("TraceId", props["TraceId"]) if props["TraceId"].is_a?(String) && !props["TraceId"].empty?
+            event.set("SpanId", props["SpanId"]) if props["SpanId"].is_a?(String) && !props["SpanId"].empty?
+            event.set("ParentId", props["ParentId"]) if props["ParentId"].is_a?(String) && !props["ParentId"].empty?
+          end
+        rescue JSON::ParserError
+        end
+      end
+
+      # --- Sales / SFC-PosWasmRelay direct-GELF: Properties already stringified by the GITIN-1883 block above ---
+      props_str = event.get("Properties")
+      if props_str.is_a?(String) && props_str.strip.start_with?("{")
+        begin
+          top_props = JSON.parse(props_str)
+          if top_props.is_a?(Hash)
+            event.set("TraceId", top_props["TraceId"]) if top_props["TraceId"].is_a?(String) && !top_props["TraceId"].empty?
+            event.set("SpanId", top_props["SpanId"]) if top_props["SpanId"].is_a?(String) && !top_props["SpanId"].empty?
+            event.set("ParentId", top_props["ParentId"]) if top_props["ParentId"].is_a?(String) && !top_props["ParentId"].empty?
+          end
+        rescue JSON::ParserError
+        end
+      end
+    '
+  }
