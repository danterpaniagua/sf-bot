# 
# Build stage 1.
#
FROM node:22.20-alpine AS base
RUN apk add openssl && mkdir certs
RUN openssl s_client -connect bot-security.smartfran.com:443 -showcerts 2>/dev/null </dev/null   | awk '/BEGIN CERTIFICATE/,/END CERTIFICATE/'   > certs/smartfran-fullchain.pem
WORKDIR /usr/src/app
COPY package.json .
RUN npm install
COPY . .
RUN npm run build

#
# Build stage 2.
#
FROM node:22.20-alpine
RUN apk add --no-cache ca-certificates
COPY --from=base certs/* /usr/local/share/ca-certificates/
RUN update-ca-certificates
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
WORKDIR /usr/src/app
COPY --from=base /usr/src/app/package*.json .
RUN npm install --only=production
COPY --from=base /usr/src/app/dist ./dist
ENTRYPOINT ["npm", "run"]
CMD ["serve"]